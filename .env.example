# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Webflow API Configuration
WEBFLOW_API_KEY=your-webflow-api-key
WEBFLOW_SITE_ID=your-site-id
WEBFLOW_BLOG_COLLECTION_ID=your-collection-id
WEBFLOW_GUIDE_COLLECTION_ID=your-guide-collection-id

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your-cf-account-id
CLOUDFLARE_ZONE_ID=your-cf-zone-id

# Pipedrive CRM
PIPEDRIVE_API_TOKEN=your-pipedrive-api-token
PIPEDRIVE_DOMAIN=your-tenant.pipedrive.com

# Resend (Email transactionnel)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=you@your-domain.com

# Google Gemini API (Image Generation)
GOOGLE_GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-image-preview
GEMINI_IMAGE_SIZE=2K

# Supabase (requis pour /etude-clients-2026)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-key

# Destinataire des notifications de nouvelles réponses au questionnaire
NOTIFICATION_EMAIL=you@your-domain.com,colleague@your-domain.com
